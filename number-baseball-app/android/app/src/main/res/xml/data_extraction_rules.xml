<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. Same rule for cloud backup and device-to-device transfer: only the account token store. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/account.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/account.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
