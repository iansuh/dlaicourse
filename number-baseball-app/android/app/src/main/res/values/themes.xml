<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light "Clean White" theme (design/tokens.json 2.0.0). Compose draws everything; this only sets the window:
         white background, transparent system bars with dark icons (DESIGN_SYSTEM 1.1). -->
    <style name="Theme.NumBaseball" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/nb_bg</item>
        <item name="colorPrimary">@color/nb_accent</item>
        <item name="colorAccent">@color/nb_accent</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
</resources>
