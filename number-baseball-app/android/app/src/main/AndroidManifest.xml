<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Offline states on Home / search (NetworkMonitor). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Haptics table (DESIGN_SYSTEM 9): Vibrator compositions for the lamp and result patterns. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
        Pulled in by androidx.work (a dependency of the Mobile Ads SDK) for foreground workers. Nothing in this app runs
        foreground work, so both the permission and WorkManager's foreground service are removed from the merged manifest.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <!-- Auto Backup keeps only the account token store (see res/xml/*backup* and data_extraction_rules). -->
    <application
        android:name=".NumBaseballApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.NumBaseball"
        tools:targetApi="33">

        <!-- Test app ID in debug; release value comes from NB_ADMOB_APP_ID (app/build.gradle.kts). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <!-- ADAPTIVE.md: 320 × 320 dp minimum window (free-form and split screen). -->
            <layout
                android:minWidth="320dp"
                android:minHeight="320dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Stores the in-app language choice on Android 12 and lower (AppCompatDelegate.setApplicationLocales). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />
    </application>
</manifest>
