{
  "$schema_note": "Design tokens for Number Baseball (Android). Map 1:1 to Compose. Colors are #AARRGGBB (use 0xAARRGGBB in Kotlin). Sizes: dp unless the key ends in _sp. Durations in ms. Easing as cubic-bezier [x1, y1, x2, y2]. Source of truth: this file. prototype/css/tokens.css is generated from it.",
  "meta": {
    "name": "Night Game",
    "version": "1.0.0",
    "theme": "dark-only",
    "grid_dp": 4
  },

  "color": {
    "bg":             { "value": "#FF0C1210", "use": "Window background, behind system bars (edge-to-edge)." },
    "surface1":       { "value": "#FF131A17", "use": "Bands and panels laid on bg: duel strip, memo board, list sections, top bar on scroll." },
    "surface2":       { "value": "#FF1A231F", "use": "Plates: keypad keys, digit slots, text fields, segmented track." },
    "surface3":       { "value": "#FF222D28", "use": "Raised: bottom sheets, dialogs, toasts, menus. Pressed state of surface2." },
    "surface4":       { "value": "#FF2B3732", "use": "Pressed state on surface3. Never a resting surface." },
    "line":           { "value": "#FF2A3530", "use": "1dp hairlines and dividers. Decorative only, never the only boundary of a control." },
    "outline":        { "value": "#FF6C7C74", "use": "1dp boundary of controls that need one (empty slot, text field, outline button). >= 3:1 on bg..surface3." },

    "chalk":          { "value": "#FFECEFE6", "use": "Primary text and icons. Fill of the primary button and selected states." },
    "chalkPressed":   { "value": "#FFD3D8CC", "use": "Primary button pressed." },
    "onChalk":        { "value": "#FF0C1210", "use": "Text and icons on chalk fills." },
    "text2":          { "value": "#FFA5B1AA", "use": "Secondary text: subtitles, column labels, opponent data." },
    "text3":          { "value": "#FF909D96", "use": "Tertiary text: captions, round numbers, placeholders. Only on bg..surface3." },
    "textDisabled":   { "value": "#FF56625C", "use": "Disabled text and icons (exempt from contrast)." },

    "strike":         { "value": "#FFF5B83D", "use": "Strike lamp and S label. Also: warning state, win accent. Always paired with text." },
    "ball":           { "value": "#FF45C98B", "use": "Ball lamp and B label. Also: success / online state. Always paired with text." },
    "out":            { "value": "#FFFF6359", "use": "Out lamp and OUT label. Also: error and destructive state. Always paired with text." },
    "lampOff":        { "value": "#FF2E3A35", "use": "Unlit lamp disc." },
    "lampOffRing":    { "value": "#FF3B4943", "use": "1dp ring of an unlit lamp." },
    "strikeGlow":     { "value": "#59F5B83D", "use": "Lit strike lamp glow (35%), blur radius = lamp size." },
    "ballGlow":       { "value": "#5945C98B", "use": "Lit ball lamp glow (35%)." },
    "outGlow":        { "value": "#59FF6359", "use": "Lit out lamp glow (35%)." },
    "strikeTint":     { "value": "#1FF5B83D", "use": "12% amber wash behind a won result header and the winning duel row." },
    "outTint":        { "value": "#1FFF6359", "use": "12% red wash behind an error banner and an invalid slot." },

    "teamA":          { "value": "#FF6EB0FF", "use": "Team A marker (stripe, badge, name). Always with the letter A." },
    "teamATint":      { "value": "#1F6EB0FF", "use": "12% wash for team A column header and 'my team' rows." },
    "teamB":          { "value": "#FFECEFE6", "use": "Team B marker (home whites). Always with the letter B." },
    "teamBTint":      { "value": "#14ECEFE6", "use": "8% wash for team B column header and 'my team' rows." },

    "scrim":          { "value": "#A3000000", "use": "64% black behind dialogs and sheets." },
    "shadow":         { "value": "#7A000000", "use": "Shadow of raised surfaces (48%)." },
    "focus":          { "value": "#FFECEFE6", "use": "2dp keyboard / switch-access focus ring, 2dp outside the control." }
  },

  "contrast_checked": {
    "note": "WCAG 2.x ratios, computed. Text needs 4.5 (3.0 for >= 18.66sp bold / 24sp). UI boundaries need 3.0.",
    "chalk_on_bg": 16.27, "chalk_on_surface3": 12.25,
    "text2_on_bg": 8.53, "text2_on_surface3": 6.42,
    "text3_on_bg": 6.71, "text3_on_surface3": 5.05,
    "outline_on_bg": 4.30, "outline_on_surface3": 3.24,
    "strike_on_bg": 10.64, "strike_on_surface3": 8.01,
    "ball_on_bg": 8.99, "ball_on_surface3": 6.77,
    "out_on_bg": 6.47, "out_on_surface3": 4.87,
    "teamA_on_bg": 8.40, "teamA_on_surface3": 6.32,
    "onChalk_on_chalk": 16.27,
    "lit_strike_vs_lampOff": 6.66, "lit_ball_vs_lampOff": 5.63, "lit_out_vs_lampOff": 4.05
  },

  "font": {
    "sans": {
      "android": "System default (FontFamily.Default). Roboto / device Latin face; Noto Sans CJK or the OEM face for Hangul, kana, Han; Cyrillic and Vietnamese from the same system face.",
      "weights": [400, 700],
      "weights_note": "Only 400 and 700. Many devices ship CJK in Regular and Bold only, so 500/600 would render inconsistently across scripts."
    },
    "num": {
      "android": "res/font: barlow_condensed_medium.ttf (500), barlow_condensed_semibold.ttf (600), barlow_condensed_bold.ttf (700)",
      "licence": "SIL OFL 1.1",
      "coverage": "Latin only. Use ONLY for digits, the letters S B O A, OUT, VS, R, room codes, # tags and the Latin wordmark. Never for translated strings.",
      "weights": [500, 600, 700],
      "features_note": "Default digits are proportional. Set fontFeatureSettings = \"tnum\" wherever numbers must align (timer, history, scores, stats)."
    }
  },

  "type": {
    "display":     { "font": "sans", "size_sp": 40, "line_sp": 48, "weight": 700, "tracking_em": 0,     "use": "Result headline (승리 / 패배 / 무승부)." },
    "headline":    { "font": "sans", "size_sp": 26, "line_sp": 34, "weight": 700, "tracking_em": 0,     "use": "First-run titles, empty-state titles." },
    "title":       { "font": "sans", "size_sp": 20, "line_sp": 28, "weight": 700, "tracking_em": 0,     "use": "Top bar title, sheet and dialog title." },
    "subtitle":    { "font": "sans", "size_sp": 16, "line_sp": 22, "weight": 700, "tracking_em": 0,     "use": "List row title, section title, player name." },
    "body":        { "font": "sans", "size_sp": 15, "line_sp": 22, "weight": 400, "tracking_em": 0,     "use": "Running text, chat messages, row subtitles." },
    "bodyStrong":  { "font": "sans", "size_sp": 15, "line_sp": 22, "weight": 700, "tracking_em": 0,     "use": "Emphasis inside body." },
    "label":       { "font": "sans", "size_sp": 16, "line_sp": 20, "weight": 700, "tracking_em": 0,     "use": "Buttons." },
    "labelSmall":  { "font": "sans", "size_sp": 13, "line_sp": 18, "weight": 700, "tracking_em": 0,     "use": "Chips, segmented items, column headers, text buttons in bars." },
    "caption":     { "font": "sans", "size_sp": 13, "line_sp": 18, "weight": 400, "tracking_em": 0,     "use": "Helper text, timestamps, status lines." },
    "micro":       { "font": "sans", "size_sp": 12, "line_sp": 16, "weight": 700, "tracking_em": 0,     "use": "Tags (방장, 나, 오프라인). Minimum size in the app." },

    "numHero":     { "font": "num", "size_sp": 56, "line_sp": 60, "weight": 600, "tracking_em": 0,     "tnum": true,  "use": "Result: revealed secret digits." },
    "numScore":    { "font": "num", "size_sp": 56, "line_sp": 60, "weight": 700, "tracking_em": 0,     "tnum": true,  "use": "Team score on board and result." },
    "numSlot":     { "font": "num", "size_sp": 40, "line_sp": 44, "weight": 600, "tracking_em": 0,     "tnum": true,  "use": "Digit in a secret / guess slot." },
    "numCode":     { "font": "num", "size_sp": 36, "line_sp": 40, "weight": 600, "tracking_em": 0,     "tnum": true,  "use": "Room code plates." },
    "numStat":     { "font": "num", "size_sp": 32, "line_sp": 36, "weight": 600, "tracking_em": 0,     "tnum": true,  "use": "Record numbers (W / L / D)." },
    "numKey":      { "font": "num", "size_sp": 30, "line_sp": 36, "weight": 500, "tracking_em": 0,     "tnum": true,  "use": "Keypad digit." },
    "numSlotSm":   { "font": "num", "size_sp": 28, "line_sp": 32, "weight": 600, "tracking_em": 0,     "tnum": true,  "use": "Slot digit in compact window; latest history row guess." },
    "numTimer":    { "font": "num", "size_sp": 24, "line_sp": 28, "weight": 600, "tracking_em": 0,     "tnum": true,  "use": "Pitch clock." },
    "numLog":      { "font": "num", "size_sp": 22, "line_sp": 28, "weight": 500, "tracking_em": 0.14,  "tnum": true,  "use": "History guess digits." },
    "numHint":     { "font": "num", "size_sp": 20, "line_sp": 24, "weight": 600, "tracking_em": 0.02,  "tnum": true,  "use": "Hint counts 2S 1B, OUT." },
    "numMemo":     { "font": "num", "size_sp": 18, "line_sp": 22, "weight": 600, "tracking_em": 0,     "tnum": true,  "use": "Memo board digits." },
    "numLabel":    { "font": "num", "size_sp": 14, "line_sp": 16, "weight": 600, "tracking_em": 0.06,  "tnum": true,  "use": "Lamp letters S B O, round numbers, VS, team letters." },
    "numTag":      { "font": "num", "size_sp": 15, "line_sp": 20, "weight": 500, "tracking_em": 0.02,  "tnum": true,  "use": "#1234 player tag next to a nickname." }
  },

  "font_scale": {
    "body_text": "Scales fully to 200%.",
    "numerals_in_fixed_controls_max": 1.3,
    "numerals_note": "Numerals inside slots, keys, memo cells and lamps use size_sp * min(fontScale, 1.3). The control grows with heightIn(min = token) when text needs more.",
    "large_layout_threshold": 1.5
  },

  "space": {
    "s0": 0, "s2": 2, "s4": 4, "s8": 8, "s12": 12, "s16": 16, "s20": 20, "s24": 24, "s32": 32, "s40": 40, "s48": 48, "s64": 64
  },

  "layout": {
    "margin": 16,
    "margin_compact": 12,
    "gutter": 8,
    "section_gap": 24,
    "top_bar_h": 56,
    "duel_strip_h": 52,
    "list_row_h": 64,
    "list_row_h_single": 56,
    "touch_min": 48,
    "content_max_w": 560,
    "compact_height_below": 480,
    "expanded_width_from": 840,
    "medium_width_from": 600,
    "banner_slot_min_h": 50,
    "banner_slot_max_h": 90,
    "banner_hide_window_height_below": 480
  },

  "size": {
    "icon": 24,
    "icon_small": 20,
    "icon_button": 48,
    "button_h": 56,
    "button_h_secondary": 48,
    "button_h_small": 36,
    "key_h": 52,
    "key_gap": 8,
    "slot_w": 56,
    "slot_w_min": 44,
    "slot_h": 64,
    "slot_h_compact": 48,
    "slot_gap": 8,
    "lamp_l": 12,
    "lamp_m": 8,
    "lamp_s": 6,
    "lamp_gap_l": 6,
    "lamp_gap_s": 3,
    "history_row_h": 44,
    "history_row_latest_h": 64,
    "history_header_h": 28,
    "memo_label_col_w": 24,
    "memo_header_h": 36,
    "memo_cell_h": 32,
    "memo_toolbar_h": 36,
    "chip_h": 32,
    "segmented_h": 44,
    "text_field_h": 56,
    "stripe_w": 3,
    "hairline": 1,
    "focus_ring": 2
  },

  "radius": {
    "none": 0, "s": 4, "m": 8, "l": 16, "full": 999
  },

  "elevation": {
    "level0": { "surface": "bg",       "shadow": "none" },
    "level1": { "surface": "surface1", "shadow": "none" },
    "level2": { "surface": "surface2", "shadow": "none" },
    "level3": { "surface": "surface3", "shadow": { "y": 8, "blur": 24, "color": "shadow" }, "use": "Sheets, dialogs, toasts, menus." }
  },

  "motion": {
    "duration": {
      "tap": 90,
      "short": 150,
      "medium": 240,
      "long": 360,
      "lamp_ignite": 180,
      "lamp_stagger": 110,
      "slot_fill": 120,
      "shake": 280,
      "result_hero": 640,
      "match_found": 900,
      "toast_visible": 2800,
      "waiting_chase_cycle": 1200
    },
    "easing": {
      "standard":   [0.2, 0.0, 0.0, 1.0],
      "decelerate": [0.0, 0.0, 0.0, 1.0],
      "accelerate": [0.3, 0.0, 1.0, 1.0],
      "emphasized": [0.05, 0.7, 0.1, 1.0],
      "ignite":     [0.2, 0.0, 0.0, 1.0],
      "linear":     [0.0, 0.0, 1.0, 1.0]
    },
    "spring": {
      "slot_pop":   { "damping_ratio": 0.6, "stiffness": 800 },
      "sheet":      { "damping_ratio": 1.0, "stiffness": 500 }
    },
    "distance": {
      "slide_in": 24,
      "shake_amplitude": 6,
      "row_insert": 12
    }
  },

  "haptic": {
    "key_digit":       { "android": "HapticFeedbackConstants.KEYBOARD_TAP" },
    "key_backspace":   { "android": "HapticFeedbackConstants.KEYBOARD_TAP" },
    "key_rejected":    { "android": "HapticFeedbackConstants.REJECT", "fallback_below_api30": "LONG_PRESS" },
    "pitch_submit":    { "android": "HapticFeedbackConstants.CONFIRM", "fallback_below_api30": "VIRTUAL_KEY" },
    "lamp_strike":     { "android": "VibrationEffect.Composition PRIMITIVE_CLICK", "scale": 0.7, "fallback": "CLOCK_TICK" },
    "lamp_ball":       { "android": "VibrationEffect.Composition PRIMITIVE_TICK", "scale": 0.5, "fallback": "CLOCK_TICK" },
    "lamp_out":        { "android": "VibrationEffect.Composition PRIMITIVE_THUD", "scale": 0.6, "fallback": "LONG_PRESS" },
    "win":             { "android": "Composition: CLICK 1.0, +70ms CLICK 1.0, +70ms QUICK_RISE 0.8", "fallback": "CONFIRM" },
    "lose":            { "android": "Composition: THUD 0.4", "fallback": "LONG_PRESS" },
    "draw":            { "android": "Composition: TICK 0.6, +90ms TICK 0.6", "fallback": "CLOCK_TICK" },
    "timer_10s":       { "android": "Composition: TICK 0.5", "fallback": "CLOCK_TICK" },
    "timer_last5":     { "android": "Composition: TICK 0.35 each second", "fallback": "CLOCK_TICK" },
    "match_found":     { "android": "Composition: CLICK 0.8, +120ms CLICK 1.0", "fallback": "CONFIRM" },
    "memo_cycle":      { "android": "HapticFeedbackConstants.CLOCK_TICK" },
    "long_press":      { "android": "HapticFeedbackConstants.LONG_PRESS" },
    "toggle":          { "android": "HapticFeedbackConstants.TOGGLE_ON / TOGGLE_OFF", "fallback_below_api34": "CLOCK_TICK" }
  }
}
